# ===================================================================
#  adhs.works · Konfiguration für Hostinger (Apache/LiteSpeed)
#  Rein statische Seite + send-booking.php. Datei ins Web-Root
#  (public_html/) legen – "versteckte Dateien anzeigen" aktivieren.
# ===================================================================

# ── 1. www -> non-www + HTTPS erzwingen ────────────────────────────
RewriteEngine On
# Versteckte Dateien und Ordner (.git, .claude, .gitignore ...) nie ausliefern;
# .well-known bleibt frei (wird fuer SSL-Zertifikate gebraucht)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── 2. Eigene Fehlerseite ──────────────────────────────────────────
ErrorDocument 404 /404.html

# ── 3. Sicherheits-Header ──────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self' mailto:; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# ── 4. Komprimierung ───────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

# ── 5. Browser-Caching (JS/CSS mit ?v= versionieren!) ──────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 week"
  # Seiten: Browser fragen jedes Mal kurz nach -> Aenderungen sind sofort sichtbar
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 6 months"
  ExpiresByType image/png               "access plus 6 months"
  ExpiresByType image/svg+xml           "access plus 6 months"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

# ── 6. Verzeichnis-Listing deaktivieren ────────────────────────────
Options -Indexes
